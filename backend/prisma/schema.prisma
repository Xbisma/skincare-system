// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

enum SkinType {
  OILY
  DRY
  COMBINATION
  SENSITITVE
  NORMAL
}

enum RoutineTime {
  AM
  PM
}

enum ReactionType {
  IRRITATION
  REDNESS
  BREAKOUT
  DRYNESS
  STINIGING
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  name         String?
  dateOfBirth  DateTime?
  skinType     SkinType?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userProducts  UserProduct[]
  routines      Routine[]
  usageLogs     usageLog[]
  skinReactions skinReaction[]
}

model Prduct {
  id        String @id @default(uuid())
  name      String
  brand     String
  category  String?
  createdAt DateTime @default(now())

  userProducts UserProduct[]

  @@unique([name, brand])
}

model UserProduct {
  id           String @id @default(uuid())
  userId       String
  productId    String
  openDate     DateTime?
  expiryDate   DateTime?
  paoMonths    Int?
  notes        String?
  createdAt    DateTime @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  routineSteps RoutineStep[]
  usageLogs    UsageLog[]

  @@index([userId])
  @@index([productId])
  @@unique([userId, productId, openDate])
}

model Routine {
  id           String @id @default(uuid())
  userId       String
  name         String
  routineTime  RoutineTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps RoutineStep[]
  usageLogs UsageLog[]

  @@unique([userId, name])
  @@index([userId])
}

model RoutineStep {
  id           String @id @default(uuid())
  routineId    String
  userProductId  String
  stepOrder    Int
  instructions String?
  createdAt    DateTime @default(now())

  routine Routine @relation(fields: [routineId], references[id], onDelete: Cascade)
  userProduct UserProduct @relation(fields: [userProductId], references[id], onDelete: Restrict)

  @@unique([routineId, stepOrder])
  @@index([routineId])
  @@index([userProductId])
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
